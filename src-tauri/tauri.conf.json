{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AJAZZ AJ139 Control",
  "version": "0.1.0",
  "identifier": "com.thiago.ajazz-aj139-control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev:vite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AJAZZ AJ139 Control",
        "width": 1220,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "decorations": false,
        "backgroundColor": "#0e1013",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeStartupBoost --renderer-process-limit=1 --disable-gpu --disable-background-networking --disable-component-update --no-first-run"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] }
    }
  }
}
